<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/styles.css" />
  <script src="https://kit.fontawesome.com/53d5910f58.js" crossorigin="anonymous"></script>
  <title> <% title %> </title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Google+Sans+Flex:opsz,wght@1..144,1..1000&display=swap" rel="stylesheet">
  <script src="https://kit.fontawesome.com/53d5910f58.js" crossorigin="anonymous" defer></script>
</head>

<body>
  <div class="container">
    <div class="login-container">
      <div class="access-form liquid-glass">
        <% if (route === "login") { %>
        <%- include("partials/login-form.ejs") %>
        <% } else if (route === "sign-up") { %>
        <%- include("partials/sign-up-form.ejs") %>
        <% } %>
      </div>
    </div>
  </div>

  <svg style="display: none;">
    <filter id="liquid-refraction">
      <feTurbulence type="fractalNoise" baseFrequency="0.015" numOctaves="2" seed="5" result="noise" />
      <feGaussianBlur in="noise" stdDeviation="2" result="softNoise" />
      <feDisplacementMap in="SourceGraphic" in2="softNoise" scale="35" xChannelSelector="R" yChannelSelector="G" />
    </filter>
  </svg>
</body>

</html>