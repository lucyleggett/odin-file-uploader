<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>mmbr</title>
  <link rel="stylesheet" href="/styles.css" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Google+Sans+Flex:opsz,wght@1..144,1..1000&display=swap" rel="stylesheet">
  <script src="https://kit.fontawesome.com/53d5910f58.js" crossorigin="anonymous" defer></script>
</head>

<body>
  <div class="container">
    <%- include("partials/navbar.ejs") %>

    <div class="index-container">

      <% if (locals.user && (!user.member || !user.admin)) { %>
      <%- include("partials/sidebar.ejs") %>
      <% } %>

      <main>
        <div class="title">
          <h2>Messages</h2>

          <% if (!locals.user) { %>
          <h3>Please <a href="/login">log in</a> to post and view message authors</h3>
          <% } %>
        </div>

        <% if (locals.messages?.length > 0) { %>
        <div class="message-container">
          <% messages.forEach((msg) => { %>
          <%- include("partials/message.ejs", {
              id: msg.id,
              username: msg.username,
              date: msg.date,
              text: msg.text
            }) %>
          <% }) %>
        </div>
        <% } else { %>
        <p>No messages found. Be the first to post!</p>
        <% } %>

        <% if (locals.user) { %>
        <%- include("partials/new-message-form.ejs") %>
        <% } %>
      </main>
    </div>

    <%- include("partials/footer.ejs") %>
  </div>

</body>

</html>