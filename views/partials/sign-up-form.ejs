<form action="/sign-up" method="POST">
  <h1>Sign Up</h1>

  <%- include("field", { name: "username", label: "Username", type: "text", placeholder: "Username" }) %>
  <%- include("field", { name: "first_name", label: "First name", type: "text", placeholder: "First name" }) %>
  <%- include("field", { name: "surname", label: "Surname", type: "text", placeholder: "Surname" }) %>
  <%- include("field", { name: "create_password", label: "Password", type: "password", placeholder: "Create password" }) %>
  <%- include("field", { name: "confirm_password", label: "Confirm password", type: "password", placeholder: "Confirm password" }) %>

  <button type="submit">Sign up</button>

  <small>Already have an account? <a href="/login">Log in here</a></small>
</form>